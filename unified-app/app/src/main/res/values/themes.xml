<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Mashxall" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#C9A44C</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#071E1A</item>
        <item name="android:statusBarColor">#071E1A</item>
        <item name="android:windowActionModeOverlay">true</item>
        <!-- Keep Android's instant starting window, but show only the app-matching
             surface color: no logo, artwork, splash animation, or intro on relaunch. -->
        <item name="android:windowBackground">#071E1A</item>
    </style>
</resources>
