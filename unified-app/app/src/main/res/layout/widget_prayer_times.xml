<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_prayer_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="180dp"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@drawable/widget_prayer_background">

    <TextView
        android:id="@+id/widget_prayer_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="مەشخەڵ • کاتی نوێژ"
        android:textColor="#FFF3D4"
        android:textSize="13sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="3dp">

        <TextView
            android:id="@+id/widget_prayer_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Location"
            android:textColor="#D3E5D9"
            android:textSize="9sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/widget_prayer_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2026-10-23"
            android:textColor="#D3E5D9"
            android:textSize="9sp"
            android:includeFontPadding="false" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_prayer_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="@drawable/widget_prayer_next_background"
        android:text="Next: Fajr • 05:00"
        android:textColor="#FFF3D4"
        android:textStyle="bold"
        android:textSize="10sp"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="5dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_time_fajr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_prayer_cell_background">
            <TextView
                android:id="@+id/widget_label_fajr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fajr"
                android:textColor="#D9E8DE"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_value_fajr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--:--"
                android:textColor="#FFF3D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_time_sunrise"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_prayer_cell_background">
            <TextView
                android:id="@+id/widget_label_sunrise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sunrise"
                android:textColor="#D9E8DE"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_value_sunrise"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--:--"
                android:textColor="#FFF3D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_time_dhuhr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_prayer_cell_background">
            <TextView
                android:id="@+id/widget_label_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dhuhr"
                android:textColor="#D9E8DE"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_value_dhuhr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--:--"
                android:textColor="#FFF3D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="3dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_time_asr"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_prayer_cell_background">
            <TextView
                android:id="@+id/widget_label_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Asr"
                android:textColor="#D9E8DE"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_value_asr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--:--"
                android:textColor="#FFF3D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_time_maghrib"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_prayer_cell_background">
            <TextView
                android:id="@+id/widget_label_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Maghrib"
                android:textColor="#D9E8DE"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_value_maghrib"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--:--"
                android:textColor="#FFF3D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_time_isha"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp"
            android:background="@drawable/widget_prayer_cell_background">
            <TextView
                android:id="@+id/widget_label_isha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Isha"
                android:textColor="#D9E8DE"
                android:textSize="9sp"
                android:gravity="center"
                android:maxLines="1"
                android:ellipsize="end"
                android:includeFontPadding="false" />
            <TextView
                android:id="@+id/widget_value_isha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="--:--"
                android:textColor="#FFF3D4"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"
                android:maxLines="1"
                android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
