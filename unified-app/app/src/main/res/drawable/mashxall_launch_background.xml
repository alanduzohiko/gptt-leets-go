<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#061711"
                android:centerColor="#123F31"
                android:endColor="#061711" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:gradientRadius="270dp"
                android:centerX="50%"
                android:centerY="46%"
                android:startColor="#3DC9A44C"
                android:endColor="#000C3027" />
        </shape>
    </item>
    <item
        android:width="174dp"
        android:height="174dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/mashxall_welcome_logo"
            android:gravity="fill" />
    </item>
</layer-list>
